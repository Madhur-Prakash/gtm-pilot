/* gtm-pilot styles */

#gpus {
    border: round $accent;
    border-title-color: $accent;
    padding: 0 1;
    margin: 1 1 0 1;
    width: auto;
    max-width: 100%;
    height: auto;
}

#actions {
    margin: 1 1;
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

/* ---------- dialogs ---------- */

OptionsForm, FilePicker, KeysScreen {
    align: center middle;
}

.dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 100%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.dialog.wide {
    width: 100;
}

/* The scrolling part of a dialog. Its height is capped at run time, to
   the room the title, errors and buttons leave: see screens/fit.py */
.dialog-body {
    height: auto;
}

/* Labels are as wide as their text by default, which ran long titles and
   questions off the side of a narrow dialog: wrap them instead */
.dialog-title {
    width: 100%;
    text-style: bold;
    margin-bottom: 1;
}

.field-label {
    width: 100%;
    margin-top: 1;
    color: $text-muted;
}

.dialog Checkbox {
    margin-top: 1;
}

.dialog Input {
    border: round $primary;
    background: $surface;
}

.dialog Input:focus {
    border: round $accent;
}

.dialog OptionList {
    height: auto;
}

.error {
    color: $error;
    height: auto;
}

.hint, .intro {
    color: $text-muted;
    margin: 1 0;
}

.intro {
    margin: 1 1 0 1;
}

.buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

.buttons Button {
    margin-left: 1;
}

/* ---------- output pages ---------- */

#output-scroll {
    height: 1fr;
    margin: 1 1 0 1;
    border: round $panel;
}

#output-body {
    padding: 0 1;
    width: auto;
}

#loading, #measure-loading {
    height: 3;
}

/* ---------- record / measure ---------- */

#record-box, #measure-box {
    height: auto;
    margin: 1 2;
    padding: 1 2;
    border: round $accent;
}

#record-status {
    margin-top: 1;
}

#record-progress {
    margin-top: 1;
}

/* ---------- gputaskman not found ---------- */

#missing-box {
    height: auto;
    margin: 1 2;
    padding: 1 2;
    border: round $error;
}
